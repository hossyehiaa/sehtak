# ==========================================================
# Sehtak AI (صحتك AI) - Environment Configuration
# ==========================================================

# Application Settings
APP_NAME="Sehtak AI - Proactive Medical Safety & Triage Guardian"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite Async by default, PostgreSQL ready)
DATABASE_URL="sqlite+aiosqlite:///./sehtak_ai.db"

# Google Gemini 2.5 Flash Configuration (Primary Multimodal AI)
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# OpenAI / Groq Fallback Configuration (Optional)
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Telegram Bot Configuration (aiogram 3.x)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
ENABLE_TELEGRAM_POLLING=false

# WhatsApp Cloud API Configuration (Meta Graph API)
WHATSAPP_VERIFY_TOKEN="sehtak-whatsapp-verify-secret-2026"
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-cloud-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# Reports Output Directory
REPORTS_OUTPUT_DIR="./generated_reports"
